{
  "info": {
    "name": "Caminho do Vale - API (seguranca)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Login em 2 etapas (senha + codigo do app). Rode 1a, depois 1b (ou 1c/1d). O token fica salvo na variavel {{access}} e as outras requisicoes usam sozinhas."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "email",
      "value": "vendedor-a@teste.local"
    },
    {
      "key": "senha",
      "value": ""
    },
    {
      "key": "codigo",
      "value": ""
    },
    {
      "key": "mfa_token",
      "value": ""
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "id_de_outro",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login (2FA)",
      "item": [
        {
          "name": "1a. Login (e-mail + senha)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Devolve mfa_token (5 min). Nao devolve access.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "if (d.mfa_token) pm.collectionVariables.set('mfa_token', d.mfa_token);",
                  "pm.test('senha certa NAO devolve o token de acesso', () => pm.expect(d.access).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "1b. Verificar codigo do app",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/2fa/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "2fa",
                "verify"
              ]
            },
            "description": "Ponha o codigo de 6 digitos na variavel 'codigo' (ou direto no corpo).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_token\": \"{{mfa_token}}\",\n  \"code\": \"{{codigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "if (d.access) { pm.collectionVariables.set('access', d.access); pm.collectionVariables.set('refresh', d.refresh); }",
                  "if (d.recovery_codes) console.log('CODIGOS DE RECUPERACAO (guarde):', d.recovery_codes.join(', '));"
                ]
              }
            }
          ]
        },
        {
          "name": "1c. Primeiro acesso: QR Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/2fa/setup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "2fa",
                "setup"
              ]
            },
            "description": "So quando mfa_setup_required=true. Use o 'secret' no app autenticador.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_token\": \"{{mfa_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1d. Primeiro acesso: ativar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/2fa/activate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "2fa",
                "activate"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_token\": \"{{mfa_token}}\",\n  \"code\": \"{{codigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "if (d.access) { pm.collectionVariables.set('access', d.access); pm.collectionVariables.set('refresh', d.refresh); }",
                  "if (d.recovery_codes) console.log('CODIGOS DE RECUPERACAO (guarde):', d.recovery_codes.join(', '));"
                ]
              }
            }
          ]
        },
        {
          "name": "1e. Entrar com codigo de recuperacao",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/2fa/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "2fa",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_token\": \"{{mfa_token}}\",\n  \"recovery_code\": \"XXXX-XXXX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data || {};",
                  "if (d.access) { pm.collectionVariables.set('access', d.access); pm.collectionVariables.set('refresh', d.refresh); }",
                  "if (d.recovery_codes) console.log('CODIGOS DE RECUPERACAO (guarde):', d.recovery_codes.join(', '));"
                ]
              }
            }
          ]
        },
        {
          "name": "1f. Quem sou eu",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        }
      ]
    },
